# Copy this file to .env.local and fill in what you have. Every adapter in
# this app runs on a labelled fixture when its key is absent — nothing here
# is required to run the app, only to switch specific data sources from
# "synthetic" to "live" in the UI's provenance labels.

# LTA DataMall — https://datamall.lta.gov.sg (free, register for an AccountKey)
# Powers: TrainServiceAlerts, PCDRealTime, PCDForecast, v3/BusArrival.
LTA_ACCOUNT_KEY=

# OneMap — https://www.onemap.gov.sg/apidocs/ (free, register for a token)
# Not required for the bounded Punggol<->one-north corridor (which uses the
# provided station GeoJSON + OSM routing instead), but the adapter is wired
# for it if you want to extend geocoding/routing beyond the corridor.
ONEMAP_TOKEN=

# Web Push (VAPID). Generate your own pair with:
#   npx web-push generate-vapid-keys
# Only needed to test the closed-app notification path; the in-app
# foreground experience works without it.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
